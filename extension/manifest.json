{
  "manifest_version": 3,
  "name": "B站小黄鸭插帧助手",
  "version": "1.4.5",
  "description": "支持B站视频与直播弹幕随视频帧同步，含表情弹幕合成及页面动画控制。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "B站小黄鸭插帧助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "core.js",
        "compositor.js",
        "video-sync.js",
        "live-compositor.js",
        "live-quality.js",
        "live-sync.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": [
        "bridge.js",
        "playlist-indicator.js",
        "live-periphery.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
